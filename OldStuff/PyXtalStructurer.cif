data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/c'
_symmetry_Int_Tables_number                   14
_symmetry_cell_setting                monoclinic
_cell_length_a            5.014908
_cell_length_b            6.533109
_cell_length_c            5.389792
_cell_angle_alpha        90.000000
_cell_angle_beta         90.582115
_cell_angle_gamma        90.000000
_cell_volume            176.576333

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z+1/2'
3 '-x, -y, -z'
4 'x, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Li     Li       2     0.000000    0.000000    0.000000 1
H      H        4     0.745678    0.454806    0.136249 1
H      H        4     0.804789    0.199290    0.384506 1
H      H        4     0.658346    0.169565    0.886961 1
P      P        2     0.000000    0.000000    0.500000 1
O      O        4     0.277056    0.787617    0.332225 1
O      O        4     0.874180    0.694481    0.244361 1
