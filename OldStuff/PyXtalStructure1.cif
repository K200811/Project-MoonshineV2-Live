data_from_pyxtal

_symmetry_space_group_name_H-M 'P21/c'
_symmetry_Int_Tables_number                   14
_symmetry_cell_setting                monoclinic
_cell_length_a            6.048300
_cell_length_b            7.175910
_cell_length_c            5.518708
_cell_angle_alpha        90.000000
_cell_angle_beta        103.859556
_cell_angle_gamma        90.000000
_cell_volume            232.549744

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, y+1/2, -z+1/2'
3 '-x, -y, -z'
4 'x, -y+1/2, z+1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Cu     Cu       4     0.966727    0.609586    0.186960 1
C      C        2     0.500000    0.000000    0.000000 1
O      O        4     0.574147    0.761913    0.965074 1
O      O        4     0.838259    0.553806    0.419397 1
O      O        2     0.000000    0.000000    0.500000 1
H      H        2     0.500000    0.000000    0.500000 1
H      H        2     0.000000    0.000000    0.000000 1
